                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"paymentId\", body.id);",
                  "pm.test(\"pending with an id\", () => { pm.expect(body.id).to.be.a(\"number\"); pm.expect(body.status).to.eql(\"PENDING\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
