              "raw": "{\n  \"senderAccount\": \"JO94CBJO0010000000000131000302\",\n  \"receiverAccount\": \"JO71CBJO0000000000001234567890\",\n  \"amount\": 1500.00,\n  \"currency\": \"JOD\",\n  \"notes\": \"September salary\",\n  \"creditorName\": \"Ahmad Ali\"\n}",
