          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates/default",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates",
                "default"
              ]
            }
