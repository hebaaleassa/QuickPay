        {
          "name": "List payments - created in the last 24 hours",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "pm.variables.set(\"createdFrom\", new Date(now.getTime() - 24 * 60 * 60 * 1000).toISOString());",
                  "pm.variables.set(\"createdTo\", now.toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments?createdFrom={{createdFrom}}&createdTo={{createdTo}}&pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ],
              "query": [
                {
                  "key": "createdFrom",
                  "value": "{{createdFrom}}",
                  "description": "Set by the pre-request script"
                },
                {
                  "key": "createdTo",
                  "value": "{{createdTo}}",
                  "description": "Set by the pre-request script"
                },
                {
                  "key": "pageSize",
                  "value": "100"
                }
              ]
            },
            "description": "createdFrom/createdTo take ISO-8601 instants. A \"+\" offset must be URL-encoded as %2B."
          }
        },
