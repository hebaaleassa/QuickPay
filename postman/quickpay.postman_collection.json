            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\n    { \"name\": \"senderAccount\", \"length\": 34, \"required\": true },\n    { \"name\": \"receiverAccount\", \"length\": 34, \"required\": true },\n    { \"name\": \"amount\", \"length\": 20, \"required\": true },\n    { \"name\": \"currency\", \"length\": 3, \"required\": true },\n    { \"name\": \"creditorName\", \"length\": 100, \"required\": true },\n    { \"name\": \"notes\", \"length\": 250, \"required\": false }\n  ]\n}",
              "options": {
