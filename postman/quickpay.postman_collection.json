{
  "info": {
    "name": "QuickPay Payments API",
    "description": "Payments and templates APIs of the QuickPay payments service.\n\nRun the app first, e.g. from payments/application: `mvn spring-boot:run -Dspring-boot.run.profiles=h2,liquibase`.\n\nAuth: HTTP Basic, set on the collection (admin/56789 has PAYMENT and TEMPLATE roles; tolay/12345 has PAYMENT only).\n\nBulk upload requests read files from samples/bulk, relative to the Postman working directory: set it to the project root (Settings > General > Working directory), or run with `newman run postman/quickpay.postman_collection.json --working-dir .` from the project root.\n\nFolders are ordered so the collection can be run top to bottom with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "56789"
    },
    {
      "key": "paymentId",
      "value": "1",
      "description": "Set by \"Create payment\""
    },
    {
      "key": "templateName",
      "value": "reordered"
    },
    {
      "key": "templateId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Templates",
      "item": [
        {
          "name": "Create template (reordered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"fields kept in order\", () => pm.expect(pm.response.json().fields[0].name).to.eql(\"creditorName\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"reordered\",\n  \"fields\": [\n    { \"name\": \"creditorName\", \"length\": 100, \"required\": true },\n    { \"name\": \"amount\", \"length\": 20, \"required\": true },\n    { \"name\": \"currency\", \"length\": 3, \"required\": true },\n    { \"name\": \"senderAccount\", \"length\": 34, \"required\": true },\n    { \"name\": \"receiverAccount\", \"length\": 34, \"required\": true },\n    { \"name\": \"notes\", \"length\": 500, \"required\": false }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a template whose columns are in a different order than the default one. Used by \"Bulk upload - custom template\"."
          }
        },
        {
          "name": "Create template - duplicate name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"explains the duplicate\", () => pm.expect(pm.response.text()).to.include(\"already exists\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"reordered\",\n  \"fields\": [\n    { \"name\": \"creditorName\", \"length\": 100, \"required\": true },\n    { \"name\": \"amount\", \"length\": 20, \"required\": true },\n    { \"name\": \"currency\", \"length\": 3, \"required\": true },\n    { \"name\": \"senderAccount\", \"length\": 34, \"required\": true },\n    { \"name\": \"receiverAccount\", \"length\": 34, \"required\": true },\n    { \"name\": \"notes\", \"length\": 500, \"required\": false }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create template - duplicate fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
