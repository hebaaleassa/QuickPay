            "description": "Template ids are not returned by the API; set the templateId collection variable to an id from the database. Unknown ids return 400."
          }
        },
        {
          "name": "List templates - filter, sort, paging",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paged response\", () => pm.expect(pm.response.json()).to.have.keys(\"content\",\"pageNumber\",\"pageSize\",\"totalElements\",\"totalPages\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates?name=e&sortBy=name&direction=asc&pageNumber=0&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "e",
                  "description": "Case-insensitive partial match"
                },
                {
                  "key": "id",
                  "value": "1",
                  "disabled": true,
                  "description": "Exact match"
                },
                {
                  "key": "sortBy",
                  "value": "name",
                  "description": "id | name (case-insensitive)"
                },
                {
                  "key": "direction",
                  "value": "asc",
                  "description": "asc | desc"
                },
                {
                  "key": "pageNumber",
                  "value": "0",
                  "description": "0-based"
                },
                {
                  "key": "pageSize",
                  "value": "10",
                  "description": "1..100 (default 2)"
                }
              ]
            }
          }
        },
        {
          "name": "Get default template",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has the 6 payment columns\", () => pm.expect(pm.response.json().fields.length).to.eql(6));"
                ]
