            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"duplicate-fields\",\n  \"fields\": [\n    { \"name\": \"amount\", \"length\": 20, \"required\": true },\n    { \"name\": \"amount\", \"length\": 10, \"required\": true }\n  ]\n}",
              "options": {
