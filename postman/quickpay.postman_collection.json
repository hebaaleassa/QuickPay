            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates",
