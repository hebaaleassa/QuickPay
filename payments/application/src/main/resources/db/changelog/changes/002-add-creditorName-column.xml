<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <property name="char" value=""/>

    <changeSet id="002-add-creditorName-column" author="Hebah Aleassa">
        <addColumn tableName="payment_entity">
            <column name="creditor_name" type="VARCHAR(255 ${char})">
            <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="payment_entity" columnName="creditor_name"/>
        </rollback>
    </changeSet>

</databaseChangeLog>